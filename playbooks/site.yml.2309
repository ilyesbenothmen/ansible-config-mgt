---
- name: Include dynamic variables
  hosts: all
  become: true
 
  tasks:
    - name: Include common playbook and dynamic environment variables
      include_tasks: ../dynamic-assignments/env-vars.yml
      tags:
        - always

- name: Import common configuration
  ansible.builtin.import_playbook: ../static-assignments/common.yml

- name: Import UAT webserver configuration 
  import_playbook: ../static-assignments/uat-webservers.yml

# Set up MySQL on database servers
- name: Set up MySQL
  hosts: database
  become: true
  roles:
    - mysql

- name: Loadbalancers assignment
  import_playbook: ../static-assignments/loadbalancers.yml
  when: load_balancer_is_required 